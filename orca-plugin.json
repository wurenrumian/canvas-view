{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "id": "canvas-view",
  "name": "Canvas View",
  "version": "0.1.3",
  "publisher": "wurenrumian",
  "license": "MIT",
  "description": "Views images and SVGs on a canvas: drag to pan, wheel to zoom.",
  "repository": "https://github.com/wurenrumian/canvas-view",
  "author": {
    "name": "wurenrumian",
    "url": "https://github.com/wurenrumian"
  },
  "icon": "icon.png",
  "cover": {
    "path": "assets/cover.png",
    "alt": "Canvas View cover: a photo and a magnifier on an indigo to cyan gradient."
  },
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "sandboxed-ui",
  "pluginApi": 1,
  "capabilities": [{ "kind": "settings:own" }],
  "contributes": {
    "settings": [
      {
        "key": "wheel",
        "title": "Mouse wheel",
        "description": "Zoom the way an image canvas does, pan the way Orca's built-in viewer does, or let the viewer tell a mouse from a trackpad.",
        "type": "string",
        "enum": ["auto", "zoom", "pan"],
        "enumLabels": ["Auto-detect", "Zoom", "Pan"],
        "default": "auto"
      }
    ],
    "customEditors": [
      {
        "id": "canvas-raster",
        "title": "Canvas",
        "extensions": [
          ".png",
          ".apng",
          ".jpg",
          ".jpeg",
          ".gif",
          ".webp",
          ".bmp",
          ".ico",
          ".avif"
        ],
        "entry": "editor/viewer.html",
        "priority": "default",
        "contentKind": "bytes"
      },
      {
        "id": "canvas-svg",
        "title": "Canvas",
        "extensions": [".svg"],
        "entry": "editor/viewer.html",
        "priority": "default",
        "contentKind": "text"
      }
    ]
  }
}
